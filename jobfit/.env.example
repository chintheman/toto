# Copy to .env. Never commit the real thing.

# --- Models -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Tailoring, angle selection and claim entailment.
JOBFIT_MODEL_WRITER=claude-opus-5
# Requirement extraction and description enrichment: high volume, low judgement.
JOBFIT_MODEL_EXTRACTOR=claude-haiku-4-5-20251001

# --- LinkedIn ------------------------------------------------------------------------
# licensed | serp | guest | jobspy   (see README "Sourcing and the law")
# `guest` and `jobspy` request from LinkedIn using this server's IP. That breaches
# LinkedIn's terms and is the path that ended Proxycurl. They refuse to start without
# JOBFIT_ALLOW_UNSAFE_SOURCES=1 and must never be enabled in a hosted deployment.
JOBFIT_LINKEDIN_ROUTE=licensed
JOBFIT_ALLOW_UNSAFE_SOURCES=0

# Licensed route (hosted default). Nothing reaches LinkedIn from our infrastructure.
BRIGHTDATA_API_KEY=
BRIGHTDATA_JOBS_DATASET=gd_lpfll7v5hcqtkxl6l
# Vendor cost per record, in millionths of a USD. This sets what a search costs a user,
# so it must match your actual contracted rate or the credit ledger lies.
JOBFIT_LINKEDIN_MICRO_USD_PER_RECORD=750

# Google-for-Jobs route.
SERPAPI_KEY=
JOBFIT_SERP_MICRO_USD_PER_RECORD=40

# Self-host scraping routes only.
JOBFIT_LINKEDIN_DELAY=2.5
JOBFIT_LINKEDIN_PROXY=
JOBFIT_JOBSPY_SITES=linkedin

# --- Billing -------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Webhooks are the only thing that mints credits. Without this the signature check
# cannot run and the endpoint must refuse every request.
STRIPE_WEBHOOK_SECRET=

# --- Storage -------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
