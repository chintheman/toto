# Copy this file to `fastlane/.env.op` (gitignored) and adjust the
# vault/item/field names below to match what you actually created in
# 1Password. Then every fastlane command runs as:
#
#   op run --env-file=fastlane/.env.op -- bundle exec fastlane <lane>
#
# `op run` substitutes these op:// references with real values only in
# the child process's environment — nothing touches disk.

APP_STORE_CONNECT_API_KEY_ID="op://TotoApp Deploy/App Store Connect API Key/key_id"
APP_STORE_CONNECT_API_ISSUER_ID="op://TotoApp Deploy/App Store Connect API Key/issuer_id"
# The .p8's raw content, stored as a 1Password document field on the
# same item. If you'd rather reference it as a file path instead
# (op supports both), swap this for APP_STORE_CONNECT_API_KEY_FILEPATH
# and adjust the Fastfile's api_key lane isn't needed — it already
# checks both env vars.
APP_STORE_CONNECT_API_KEY_CONTENT="op://TotoApp Deploy/App Store Connect API Key/private key"

# The passphrase match uses to encrypt/decrypt chintheman/toto-ios-certs.
MATCH_PASSWORD="op://TotoApp Deploy/match passphrase/password"
